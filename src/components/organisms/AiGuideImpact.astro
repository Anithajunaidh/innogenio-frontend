---
import { initReveal } from '../../utils/reveal';

export interface Props {
	kicker: string;
	headline: string;
	body: string;
	cards: Array<{ number: string; title: string; body: string }>;
}

const { kicker, headline, body, cards } = Astro.props;
---

<section aria-label={kicker} class="text-ink">
	<div data-reveal class="border-t border-line px-5 pb-8 pt-12 sm:px-section-x">
		<span class="rv-block mb-4 flex items-center gap-2 font-mono text-kicker font-medium uppercase text-ink-secondary" style="--i:1">
			<svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0 fill-brand" aria-hidden="true"><path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z"></path></svg> {kicker}
		</span>
		<h2 class="rv-block m-0 max-w-[30em] text-balance text-section-head font-medium text-ink" style="--i:2">
			{headline}
		</h2>
		<p class="rv-block mt-4 max-w-3xl text-intro text-ink-secondary" style="--i:3">
			{body}
		</p>
	</div>

	<div data-reveal class="grid grid-cols-1 gap-px border-t border-line bg-line sm:grid-cols-2 md:grid-cols-4">
		{cards.map((card, i) => (
			<div class="rv-block flex min-h-[190px] flex-col gap-3.5 bg-paper px-6 py-8" style={`--i:${4 + i}`}>
				<span class="font-mono text-pill text-brand">{card.number}</span>
				<h3 class="mt-auto text-story-h font-semibold text-ink">{card.title}</h3>
				<p class="m-0 text-small text-ink-secondary">{card.body}</p>
			</div>
		))}
	</div>
</section>

