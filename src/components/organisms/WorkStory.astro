---
/* Work-detail story tabs (innogenio-work-vineo .tabs) — a horizontal
   tab bar (Challenge / Solution / Delivery) over two-column panes of
   numbered story blocks. Real tab semantics (role/aria-selected), the
   brand underline rides the selected tab via an after pseudo-element,
   and the script is instance-safe through data-work-story scoping —
   the same pattern as the listing explorer's rail. */
export interface StoryBlock {
	title: string;
	body: string;
}

export interface StoryTab {
	tab: string;
	blocks: StoryBlock[];
}

interface Props {
	tabs: StoryTab[];
	label?: string;
}
const { tabs, label = 'Case study story' } = Astro.props;
---

<section data-work-story aria-label={label} class="mt-16 border-x border-t border-line bg-paper font-sans text-ink">
	<!-- >=480: connected tab bar (scrolls if ever needed). <480: the tabs
	     become wrapping bordered buttons so nothing clips off the edge. -->
	<div
		role="tablist"
		aria-label={label}
		class="flex border-b border-line max-[480px]:flex-wrap max-[480px]:gap-2.5 max-[480px]:p-section-x min-[481px]:overflow-x-auto"
	>
		{
			tabs.map((tab, i) => (
				<button
					data-ws-tab
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
					class="relative shrink-0 border-r border-line px-[30px] py-[18px] text-btn text-ink-secondary transition-colors after:absolute after:inset-x-0 after:-bottom-px after:h-[3px] after:bg-brand after:opacity-0 hover:text-ink aria-selected:text-ink aria-selected:after:opacity-100 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none focus-visible:ring-inset max-[480px]:border max-[480px]:px-4 max-[480px]:py-2.5 max-[480px]:after:hidden max-[480px]:aria-selected:border-brand"
				>
					{tab.tab}
				</button>
			))
		}
	</div>
	{
		tabs.map((tab, i) => (
			<div
				data-ws-panel
				role="tabpanel"
				hidden={i !== 0}
				class="grid grid-cols-1 gap-x-11 gap-y-9 px-section-x py-block-y min-[880px]:grid-cols-2"
			>
				{tab.blocks.map((block, n) => (
					<div>
						<h4 class="text-story-h">
							<i class="mr-2.5 font-bold text-brand not-italic">{String(n + 1).padStart(2, '0')}</i>
							{block.title}
						</h4>
						<p class="mt-2 max-w-[34em] text-sm leading-relaxed text-ink-secondary">{block.body}</p>
					</div>
				))}
			</div>
		))
	}
</section>

<script>
	// tab bar: one selected tab shows its pane, the rest stay hidden
	document.querySelectorAll<HTMLElement>('[data-work-story]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ws-tab]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-ws-panel]')];
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
				panels.forEach((p, k) => p.toggleAttribute('hidden', k !== i));
			});
		});
	});
</script>
