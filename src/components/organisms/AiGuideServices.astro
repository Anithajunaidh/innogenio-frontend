---
import { initReveal } from '../../utils/reveal';

export interface Props {
	kicker: string;
	headline: string;
	exploreLabel: string;
	cards: Array<{ title: string; body: string; href: string }>;
}

const { kicker, headline, exploreLabel, cards } = Astro.props;
---

<section aria-label={kicker} class="text-ink">
	<div data-reveal class="border-t border-line px-5 pb-8 pt-12 sm:px-section-x">
		<span class="rv-block mb-4 flex items-center gap-2 font-mono text-kicker font-medium uppercase text-ink-secondary" style="--i:1">
			<svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0 fill-brand" aria-hidden="true"><path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z"></path></svg> {kicker}
		</span>
		<h2 class="rv-block m-0 max-w-[30em] text-balance text-section-head font-medium text-ink" style="--i:2">
			{headline}
		</h2>
	</div>

	<div data-reveal class="grid grid-cols-1 gap-px border-t border-line bg-line sm:grid-cols-2 md:grid-cols-3">
		{cards.map((card, i) => (
			<article class="rv-block flex min-h-[200px] flex-col gap-3 bg-paper px-6 py-7 transition-colors duration-300 ease-out hover:bg-card-hover" style={`--i:${3 + i}`}>
				<h3 class="m-0 text-card-title font-semibold text-ink">{card.title}</h3>
				<p class="m-0 text-sm leading-relaxed text-ink-secondary">{card.body}</p>
				<a class="mt-auto inline-flex items-center gap-2.5 text-sm font-semibold transition-colors duration-300 hover:text-brand [&:hover_.ar_rect]:opacity-100 [&:hover_.ar_rect]:translate-x-0 [&:hover_.ar_line]:scale-x-[1.45] [&:hover_.ar_path]:translate-x-[2.5px]" href={card.href}>
					{exploreLabel} 
					<svg class="ar block shrink-0 overflow-visible" viewBox="0 0 30 12" width="24" height="10" aria-hidden="true"><rect x="0" y="4.4" width="3.2" height="3.2" class="fill-current opacity-0 -translate-x-[5px] transition-all duration-[0.28s] ease-out"/><line x1="9" y1="6" x2="24.5" y2="6" class="origin-[26px_6px] stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/><path d="M19.5 1 L24.5 6 L19.5 11" class="fill-transparent stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/></svg>
				</a>
			</article>
		))}
	</div>
</section>

