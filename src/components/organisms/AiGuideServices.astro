			<p class="m-0 text-sm leading-relaxed text-ink-secondary">Production-grade pipelines that train, deploy, monitor, and retrain models reliably.</p>
			<a class="mt-auto inline-flex items-center gap-2.5 text-sm font-semibold transition-colors duration-300 hover:text-brand [&:hover_.ar_rect]:opacity-100 [&:hover_.ar_rect]:translate-x-0 [&:hover_.ar_line]:scale-x-[1.45] [&:hover_.ar_path]:translate-x-[2.5px]" href="#">
				Explore 
				<svg class="ar block shrink-0 overflow-visible" viewBox="0 0 30 12" width="24" height="10" aria-hidden="true"><rect x="0" y="4.4" width="3.2" height="3.2" class="fill-current opacity-0 -translate-x-[5px] transition-all duration-[0.28s] ease-out"/><line x1="9" y1="6" x2="24.5" y2="6" class="origin-[26px_6px] stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/><path d="M19.5 1 L24.5 6 L19.5 11" class="fill-transparent stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/></svg>
			</a>
		</article>

		<!-- Card 5 -->
		<article class="rv-block flex min-h-[200px] flex-col gap-3 bg-paper px-6 py-7 transition-colors duration-300 ease-out hover:bg-card-hover" style="--i:7">
			<h3 class="m-0 text-card-title font-semibold text-ink">Computer Vision</h3>
			<p class="m-0 text-sm leading-relaxed text-ink-secondary">Detect, inspect, and measure from images and video for quality control and safety.</p>
			<a class="mt-auto inline-flex items-center gap-2.5 text-sm font-semibold transition-colors duration-300 hover:text-brand [&:hover_.ar_rect]:opacity-100 [&:hover_.ar_rect]:translate-x-0 [&:hover_.ar_line]:scale-x-[1.45] [&:hover_.ar_path]:translate-x-[2.5px]" href="#">
				Explore 
				<svg class="ar block shrink-0 overflow-visible" viewBox="0 0 30 12" width="24" height="10" aria-hidden="true"><rect x="0" y="4.4" width="3.2" height="3.2" class="fill-current opacity-0 -translate-x-[5px] transition-all duration-[0.28s] ease-out"/><line x1="9" y1="6" x2="24.5" y2="6" class="origin-[26px_6px] stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/><path d="M19.5 1 L24.5 6 L19.5 11" class="fill-transparent stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/></svg>
			</a>
		</article>

		<!-- Card 6 -->
		<article class="rv-block flex min-h-[200px] flex-col gap-3 bg-paper px-6 py-7 transition-colors duration-300 ease-out hover:bg-card-hover" style="--i:8">
			<h3 class="m-0 text-card-title font-semibold text-ink">AI Consulting &amp; Strategy</h3>
			<p class="m-0 text-sm leading-relaxed text-ink-secondary">Assess readiness, prioritize use cases, and de-risk adoption from day one.</p>
			<a class="mt-auto inline-flex items-center gap-2.5 text-sm font-semibold transition-colors duration-300 hover:text-brand [&:hover_.ar_rect]:opacity-100 [&:hover_.ar_rect]:translate-x-0 [&:hover_.ar_line]:scale-x-[1.45] [&:hover_.ar_path]:translate-x-[2.5px]" href="#">
				Explore 
				<svg class="ar block shrink-0 overflow-visible" viewBox="0 0 30 12" width="24" height="10" aria-hidden="true"><rect x="0" y="4.4" width="3.2" height="3.2" class="fill-current opacity-0 -translate-x-[5px] transition-all duration-[0.28s] ease-out"/><line x1="9" y1="6" x2="24.5" y2="6" class="origin-[26px_6px] stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/><path d="M19.5 1 L24.5 6 L19.5 11" class="fill-transparent stroke-current stroke-[1.6] transition-transform duration-300 ease-[cubic-bezier(0.2,0.7,0.3,1)]"/></svg>
			</a>
		</article>
	</div>
</section>

<script>
	import { initReveal } from '../../utils/reveal';
	initReveal();
</script>
