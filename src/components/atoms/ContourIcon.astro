---
/* Contour icon (innogenio-home-v2 .ctr) — 24×24 line glyphs used on the
   "Services." and "Industries." cards: squared-cap strokes plus one
   filled accent node (ink/brand on paper cards, white/#E2A9F7 on the
   dark image cards via the host's [--ctr-st]/[--ctr-nd] overrides).
   Static by default; the parent card's :hover/:focus-visible replays the
   redraw + node-blip keyframes (see the .ctr rules in global.css). */

type Shape =
	| { type: 'path'; d: string }
	| { type: 'circle'; cx: number; cy: number; r: number }
	| { type: 'rect'; x: number; y: number; w: number; h: number };

interface Glyph {
	st: Shape[];
	nd: Shape;
}

const GLYPHS = {
	code: {
		st: [
			{ type: 'path', d: 'M9 6.5 L4.5 12 L9 17.5' },
			{ type: 'path', d: 'M15 6.5 L19.5 12 L15 17.5' },
		],
		nd: { type: 'rect', x: 10.8, y: 10.8, w: 2.4, h: 2.4 },
	},
	ai: {
		st: [
			{ type: 'circle', cx: 12, cy: 12, r: 3.4 },
			{ type: 'path', d: 'M12 8.6 V4 M12 15.4 V20 M8.6 12 H4 M15.4 12 H20' },
			{ type: 'path', d: 'M11 3 h2 M11 21 h2 M3 11 v2 M21 11 v2' },
		],
		nd: { type: 'circle', cx: 12, cy: 12, r: 1.5 },
	},
	erp: {
		st: [
			{ type: 'rect', x: 4, y: 4, w: 7, h: 7 },
			{ type: 'rect', x: 13, y: 4, w: 7, h: 7 },
			{ type: 'rect', x: 4, y: 13, w: 7, h: 7 },
		],
		nd: { type: 'rect', x: 13, y: 13, w: 7, h: 7 },
	},
	data: {
		st: [
			{ type: 'circle', cx: 5.6, cy: 12, r: 2.5 },
			{ type: 'path', d: 'M8.2 10.3 H16 M14.4 8.7 L16 10.3 L14.4 11.9' },
			{ type: 'path', d: 'M15.8 13.7 H8 M9.6 12.1 L8 13.7 L9.6 15.3' },
		],
		nd: { type: 'circle', cx: 18.4, cy: 12, r: 2.5 },
	},
	factory: {
		st: [
			{ type: 'path', d: 'M4.5 19.5 V11 l4.2 3 v-3 l4.2 3 v-3 h6.6 V19.5 Z' },
			{ type: 'path', d: 'M7.5 19.5 v-3.3 h2.7 v3.3' },
		],
		nd: { type: 'rect', x: 15.2, y: 13.4, w: 2.2, h: 2.2 },
	},
	bank: {
		st: [
			{ type: 'path', d: 'M4.5 9.8 L12 5 L19.5 9.8 Z' },
			{ type: 'path', d: 'M6.8 12.2 V16.8 M10.3 12.2 V16.8 M13.7 12.2 V16.8 M17.2 12.2 V16.8' },
			{ type: 'path', d: 'M4.5 19.5 H19.5' },
		],
		nd: { type: 'rect', x: 10.9, y: 7.1, w: 2.2, h: 2.2 },
	},
	cart: {
		st: [
			{ type: 'path', d: 'M4 5.8 h2.5 l2.2 8.4 h8.6 l2 -6.3 H8' },
			{ type: 'circle', cx: 9.9, cy: 17.6, r: 1.7 },
		],
		nd: { type: 'circle', cx: 16.6, cy: 17.6, r: 1.8 },
	},
	health: {
		st: [
			{
				type: 'path',
				d: 'M9.8 4.5 h4.4 v5.3 h5.3 v4.4 h-5.3 v5.3 h-4.4 v-5.3 H4.5 V9.8 h5.3 Z',
			},
		],
		nd: { type: 'rect', x: 10.9, y: 10.9, w: 2.2, h: 2.2 },
	},
} satisfies Record<string, Glyph>;

export type ContourIconName = keyof typeof GLYPHS;

interface Props {
	name: ContourIconName;
	class?: string;
}
const { name, class: className = '' } = Astro.props;
const glyph = GLYPHS[name];
---

<svg class:list={['ctr', className]} viewBox="0 0 24 24" aria-hidden="true">
	{
		glyph.st.map((s) =>
			s.type === 'path' ? (
				<path class="st" pathLength="1" d={s.d} />
			) : s.type === 'circle' ? (
				<circle class="st" pathLength="1" cx={s.cx} cy={s.cy} r={s.r} />
			) : (
				<rect class="st" pathLength="1" x={s.x} y={s.y} width={s.w} height={s.h} />
			)
		)
	}
	{
		glyph.nd.type === 'circle' ? (
			<circle class="nd" cx={glyph.nd.cx} cy={glyph.nd.cy} r={glyph.nd.r} />
		) : glyph.nd.type === 'rect' ? (
			<rect class="nd" x={glyph.nd.x} y={glyph.nd.y} width={glyph.nd.w} height={glyph.nd.h} />
		) : null
	}
</svg>
