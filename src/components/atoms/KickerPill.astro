---
/* Rounded kicker pill with a brand four-point star (innogenio-home-v2
   .impact-kicker) — mono 11px label on a tile-colored pill. */
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
	class:list={[
		'inline-flex items-center gap-[9px] rounded-full border border-line bg-tile py-[7px] pr-3.5 pl-3 font-mono text-pill text-ink-secondary',
		className,
	]}
>
	<svg viewBox="0 0 24 24" class="size-[13px] shrink-0 fill-brand" aria-hidden="true">
		<path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z"></path>
	</svg>
	<slot />
</span>
