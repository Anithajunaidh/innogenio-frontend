---
/* Pixel-art sprite (innogenio-home data-px glyphs) — the bitmap is
   compiled to two SVG paths at build time: '#' cells → primary fill,
   '*' cells → secondary fill. */
const BITMAPS = {
	logo: [
		'..######.##',
		'...#####.##',
		'....####.##',
		'...#####.##',
		'..##.###.##',
		'.##...##.##',
		'###......##',
		'##.......##',
	],
	robot: [
		'..#.....#..',
		'...#...#...',
		'..#######..',
		'.##*###*##.',
		'###########',
		'#.#######.#',
		'#.#.....#.#',
		'...##.##...',
	],
	ai: ['#..#..#', '.#.#.#.', '..###..', '###*###', '..###..', '.#.#.#.', '#..#..#'],
	erp: [
		'########',
		'##****##',
		'........',
		'########',
		'########',
		'........',
		'##****##',
		'########',
	],
	data: ['......##', '......##', '...##.##', '...##.##', '##.##.##', '##.##.##'],
	flag: ['##.#####', '##.#***#', '##.#####', '##......', '##......', '##......'],
	code: ['..#..#..', '.#....#.', '#......#', '#......#', '.#....#.', '..#..#..'],
	ops: ['..####..', '.#*..*#.', '##....##', '##....##', '.#*..*#.', '..####..'],
	factory: ['#.......', '#...#..#', '#...#..#', '########', '#*#.#*.#', '########'],
	bank: ['...##...', '..####..', '########', '#.#..#.#', '#.#..#.#', '########'],
	cart: ['##......', '.#.####.', '.#.#**#.', '.#.####.', '.######.', '..#..#..'],
	health: ['..##..', '..##..', '##**##', '##**##', '..##..', '..##..'],
	ux: [
		'#.......',
		'##......',
		'###.....',
		'####....',
		'#####...',
		'######..',
		'###*....',
		'#.##....',
		'...#....',
	],
	iot: [
		'.#..#..#.',
		'#########',
		'#*.....*#',
		'#..###..#',
		'#..###..#',
		'#*.....*#',
		'#########',
		'.#..#..#.',
	],
	book: ['########', '#..##..#', '#..##..#', '#..##..#', '#..##..#', '#..##..#', '########'],
	truck: ['#####...', '#####.##', '########', '########', '.#....#.'],
	tulip: [
		'.**.**.',
		'.*****.',
		'..***..',
		'...#...',
		'...#...',
		'#..#..#',
		'.#.#.#.',
		'..###..',
		'...#...',
		'...#...',
	],
} as const;

export type PixelSpriteName = keyof typeof BITMAPS;

interface Props {
	name: PixelSpriteName;
	class?: string;
	primary?: string;
	secondary?: string;
}
const {
	name,
	class: className = 'w-9',
	primary = '#9F00D4',
	secondary = '#E2B5F7',
} = Astro.props;

const bitmap = BITMAPS[name];
let d1 = '';
let d2 = '';
bitmap.forEach((row, y) => {
	[...row].forEach((c, x) => {
		if (c === '#') d1 += `M${x} ${y}h1v1h-1z`;
		else if (c === '*') d2 += `M${x} ${y}h1v1h-1z`;
	});
});
---

<svg
	viewBox={`0 0 ${bitmap[0].length} ${bitmap.length}`}
	shape-rendering="crispEdges"
	class={className}
	aria-hidden="true"
>
	<path fill={primary} d={d1}></path>
	{d2 && <path fill={secondary} d={d2}></path>}
</svg>
