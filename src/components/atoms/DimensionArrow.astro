---
/* Dimension-arrow — pin hidden at rest; on hover of the parent `group`
   the pin drops in, the tail stretches back to meet it, the head nudges forward. */
interface Props {
	class?: string;
}
const { class: className = 'w-6' } = Astro.props;
---

<svg
	class:list={['block flex-none overflow-visible', className]}
	viewBox="0 0 30 12"
	aria-hidden="true"
>
	<rect
		x="0"
		y="4.4"
		width="3.2"
		height="3.2"
		class="translate-x-[-5px] fill-current opacity-0 transition-[opacity,translate] duration-280 group-hover:translate-x-0 group-hover:opacity-100"
	></rect>
	<line
		x1="9"
		y1="6"
		x2="24.5"
		y2="6"
		class="origin-[26px_6px] stroke-current stroke-[1.6] transition-transform duration-300 ease-arrow group-hover:scale-x-[1.45]"
	></line>
	<path
		d="M19.5 1 L24.5 6 L19.5 11"
		class="fill-none stroke-current stroke-[1.6] transition-transform duration-300 ease-arrow group-hover:translate-x-[2.5px]"
	></path>
</svg>
