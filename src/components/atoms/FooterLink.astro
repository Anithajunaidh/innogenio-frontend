---
interface Props {
  href: string;
  label: string;
  external?: boolean;
}
const { href, label, external = false } = Astro.props;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  class="text-sm text-foreground/70 hover:text-foreground transition-colors duration-200 flex items-center gap-1"
  href={href}
  target={target}
  rel={rel}
>
  {label}
  {external && <span class="text-xs font-mono font-bold">↗</span>}
</a>
