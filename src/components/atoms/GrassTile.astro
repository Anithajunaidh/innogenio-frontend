---
interface Props {
  class?: string;
}
const { class: className = "size-12 md:size-14 lg:size-16 pixelated" } = Astro.props;
---

<svg
  role="img"
  aria-label="Grass"
  viewBox="0 0 16 16"
  width="224"
  height="224"
  class={className}
  shape-rendering="crispEdges"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- ground -->
  <rect x="0" y="12" width="16" height="4" fill="#4CAF50" />
  <rect x="0" y="14" width="16" height="2" fill="#2E7D32" />
  <!-- blades -->
  <rect x="2" y="8" width="2" height="4" fill="#66BB6A" />
  <rect x="2" y="6" width="1" height="2" fill="#66BB6A" />
  <rect x="6" y="7" width="2" height="5" fill="#4CAF50" />
  <rect x="7" y="5" width="1" height="2" fill="#4CAF50" />
  <rect x="10" y="9" width="2" height="3" fill="#66BB6A" />
  <rect x="12" y="7" width="2" height="5" fill="#4CAF50" />
  <rect x="13" y="5" width="1" height="2" fill="#4CAF50" />
</svg>
