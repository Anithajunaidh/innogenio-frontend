---
import PixelIcon from "../atoms/PixelIcon.astro";
import GrassTile from "../atoms/GrassTile.astro";
import SunSprite from "../atoms/SunSprite.astro";
import CatSprite from "../atoms/CatSprite.astro";

/* A fixed pixel cat walking in place while flowers and grass tufts scroll left
   behind it, creating the illusion of forward motion. A solid grass + dirt
   ground strip runs along the bottom. */
const iconColors = ["text-[#FF91DC]", "text-[#FA5111]", "text-[#F9D749]"];

/* One scrolling band of decorations. Cells: "flower" | "grass" | "gap". */
const band = [
  "flower", "gap", "grass", "gap", "flower", "gap", "gap",
  "grass", "flower", "gap", "grass", "gap", "flower", "gap",
];
let iconIndex = 0;
const nextColor = () => iconColors[iconIndex++ % iconColors.length];
---

<div
  class="relative min-h-36 md:min-h-56 lg:min-h-72 isolate w-full overflow-clip dark:brightness-50"
>
  <SunSprite />

  {/* Scrolling flowers + grass tufts, resting on the grass surface */}
  <div class="absolute inset-x-0 bottom-14 md:bottom-16 z-10">
    <div style="min-width:max-content;display:flex" class="animate-footer-marquee">
      {[0, 1].map(() => (
        <div class="flex items-end gap-16 md:gap-24 pr-16 md:pr-24 shrink-0">
          {band.map((cell) => {
            if (cell === "flower")
              return <PixelIcon class={`size-12 md:size-14 lg:size-16 shrink-0 ${nextColor()}`} />;
            if (cell === "grass")
              return <GrassTile class="size-10 md:size-12 lg:size-14 shrink-0 pixelated" />;
            return <div class="size-12 md:size-14 lg:size-16 shrink-0" />;
          })}
        </div>
      ))}
    </div>
  </div>

  {/* Fixed cat, walking in place on the grass */}
  <CatSprite
    src="/cat.gif"
    class="absolute left-[40%] -translate-x-1/2 bottom-12 md:bottom-14 z-20 h-20 md:h-28 lg:h-36 w-auto"
  />

  {/* Ground: solid grass strip over a checkered dirt strip */}
  <div class="absolute inset-x-0 bottom-0 z-30">
    <div class="h-6 md:h-8 bg-[#3FB64A] border-b-4 border-[#2E7D32]"></div>
    <div
      class="h-8 md:h-10"
      style="background-color:#6b3f24;background-image:repeating-conic-gradient(#5a3620 0% 25%, #7a4a2c 0% 50%);background-size:16px 16px;image-rendering:pixelated;"
    ></div>
  </div>
</div>
