---
/* Footer link columns (innogenio-home-v2 .f-cols) — up to six columns,
   passed in as data. */
import FooterLinkGroup from './FooterLinkGroup.astro';
import type { FooterLinkItem } from './FooterLinkGroup.astro';

export interface FooterColumn {
	title: string;
	links: FooterLinkItem[];
}

interface Props {
	columns: FooterColumn[];
}

const { columns } = Astro.props;
---

<div
	class="mx-auto grid max-w-[1150px] grid-cols-2 gap-x-6 gap-y-9 min-[560px]:grid-cols-3 min-[960px]:grid-cols-6"
>
	{columns.map((column) => <FooterLinkGroup title={column.title} links={column.links} />)}
</div>
