---
/* Work-detail prev/next rail (innogenio-work-vineo .wnav) — two cells
   linking the neighboring case studies; the previous cell's dimension
   arrow is mirrored and both cells wash brand-soft on hover, driving
   the shared arrow choreography via `group`. */
import DimensionArrow from '../atoms/DimensionArrow.astro';

export interface WorkNavRef {
	title: string;
	href: string;
}

interface Props {
	prev: WorkNavRef;
	next: WorkNavRef;
	prevLabel: string;
	nextLabel: string;
	label?: string;
}
const { prev, next, prevLabel, nextLabel, label = 'More case studies' } = Astro.props;
---

<nav aria-label={label} class="grid grid-cols-2 border-x border-t border-line bg-paper font-sans text-ink">
	<a
		href={prev.href}
		class="group flex flex-col gap-2 border-r border-line px-section-x py-[34px] transition-colors hover:bg-brand-soft focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none focus-visible:ring-inset"
	>
		<span class="flex items-center gap-2.5 font-mono text-f-head uppercase text-ink-secondary">
			<DimensionArrow class="w-6 -scale-x-100 text-ink" />
			{prevLabel}
		</span>
		<span class="text-ac-head">{prev.title}</span>
	</a>
	<a
		href={next.href}
		class="group flex flex-col items-end gap-2 px-section-x py-[34px] text-right transition-colors hover:bg-brand-soft focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none focus-visible:ring-inset"
	>
		<span class="flex items-center gap-2.5 font-mono text-f-head uppercase text-ink-secondary">
			{nextLabel}
			<DimensionArrow class="w-6 text-ink" />
		</span>
		<span class="text-ac-head">{next.title}</span>
	</a>
</nav>
